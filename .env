# Copy this file to .env and adjust the values. NEVER commit .env.

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
# Add your PC's LAN IP (e.g. 192.168.100.9) to test from a phone.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.100.9

# --- Database: MySQL 8.0+ (or MariaDB 10.5+) ---------------------------------
# Create it first (see README, "Setting up MySQL"):
#   CREATE DATABASE p2plend CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DB_ENGINE=mysql
DB_NAME=trustcircle
DB_USER=root
DB_PASSWORD=8998
DB_HOST=127.0.0.1
DB_PORT=3306
# DB_ENGINE=sqlite uses backend/db.sqlite3 instead (e.g. to copy old data into MySQL).
# Tests create and drop their own database, test_p2plend. For a quick run without MySQL: TEST_DB_ENGINE=sqlite

# Development: keep the cache in memory and run background tasks inline.
USE_REDIS_CACHE=False
CELERY_TASK_ALWAYS_EAGER=True
USE_REDIS_CHANNEL_LAYER=False

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

PLATFORM_CURRENCY=KES

# Verification codes: "console" prints SMS codes in the runserver terminal.
SMS_BACKEND=console
DEFAULT_FROM_EMAIL=P2P Lend <no-reply@p2plend.local>

# --- Payments ------------------------------------------------------------
# Sandbox: test deposits/withdrawals with no real money (dev default True; production refuses it).
SANDBOX_PAYMENTS_ENABLED=True
# M-Pesa (Safaricom Daraja). Leave empty until you have credentials; test in the Daraja sandbox first.
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Public HTTPS address Safaricom calls back (e.g. https://lend.example.co.ke). Use ngrok for local tests.
MPESA_CALLBACK_BASE_URL=
# Long random string; callbacks without it are rejected.
MPESA_CALLBACK_TOKEN=
MPESA_B2C_SHORTCODE=
MPESA_B2C_INITIATOR=
MPESA_B2C_SECURITY_CREDENTIAL=

# --- Notifications ---------------------------------------------------------
# Email copies of important notifications (deposits, withdrawals, defaults...).
NOTIFICATION_EMAILS=False
# Push to the Flutter app: path to a Firebase service-account JSON (and pip install firebase-admin).
FCM_CREDENTIALS_FILE=

# --- Optional: one URL instead of the DB_* values -------------------------
# DATABASE_URL=mysql://p2plend:password@127.0.0.1:3306/p2plend

# Encrypts payment and SMS keys stored in the database. Keep a copy: losing it makes saved keys unreadable.
FIELD_ENCRYPTION_KEY=
